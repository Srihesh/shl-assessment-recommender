# Copy this file to .env and fill in your key(s).
# Only one LLM key is required. GROQ_API_KEY is preferred (faster, free tier).
# Get a free Groq key at: https://console.groq.com
# Get a free Gemini key at: https://aistudio.google.com

GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here  # uncomment if using Gemini instead
